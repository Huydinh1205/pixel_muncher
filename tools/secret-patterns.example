# Words that must never appear in a commit. One extended regular expression per
# line, matched case-insensitively. Lines starting with # are ignored.
#
#   cp tools/secret-patterns.example .secret-patterns.local
#
# .secret-patterns.local is git-ignored, so you can list real names here without
# publishing them. Replace the examples below with your own.

# company, client and site names
<company-name>
<client-name>
<site-name>

# Linux user names and home folders on the workstations
/home/<workstation-user>
<workstation-user>

# internal folder names, hostnames and domains
<internal-folder-name>
<hostname>
<company-domain>\.com\.au
