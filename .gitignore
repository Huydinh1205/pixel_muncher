# =============================================================================
# Pixel Muncher GUI - files that must never be pushed
#
# .gitignore only stops untracked FILES. Words typed into tracked files (a
# company name, an IP address, a password) are caught by the pre-commit check:
#   cp tools/secret-patterns.example .secret-patterns.local
#   bash tools/install_git_hook.sh
# If a file was committed before it was ignored, untrack it with
#   git rm --cached <file>
# and remember it is still in the history until the history is rewritten.
# =============================================================================

# --- 1. Real configuration: internal paths, user names, model registry -------
config.yaml
config.site.yaml
config.*.local.yaml
*.local.yaml
!config.local.yaml
.env
.env.*
*.env

